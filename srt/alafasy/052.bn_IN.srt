1
00:00:00,000 --> 00:00:06,031
بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ

2
00:00:06,031 --> 00:00:10,833
আল্লাহ্‌র নামে আরম্ভ, যিনি পরম দয়ালু, করুণাময়।

3
00:00:10,833 --> 00:00:14,174
وَ الطُّوۡرِ ۙ﴿۱﴾

4
00:00:14,174 --> 00:00:16,013
‘তূর’-এর শপথ,

5
00:00:16,013 --> 00:00:21,361
وَ کِتٰبٍ مَّسۡطُوۡرٍ ۙ﴿۲﴾

6
00:00:21,361 --> 00:00:27,729
فِیۡ رَقٍّ مَّنۡشُوۡرٍ ۙ﴿۳﴾

7
00:00:27,729 --> 00:00:29,729
উন্মুক্ত দপ্তরের মধ্যে,

8
00:00:29,729 --> 00:00:34,052
وَّ الۡبَیۡتِ الۡمَعۡمُوۡرِ ۙ﴿۴﴾

9
00:00:34,052 --> 00:00:35,812
এবং বায়তুল মা’মূরের,

10
00:00:35,812 --> 00:00:40,424
وَ السَّقۡفِ الۡمَرۡفُوۡعِ ۙ﴿۵﴾

11
00:00:40,424 --> 00:00:42,346
এবং সমুন্নত ছাদের,

12
00:00:42,346 --> 00:00:47,218
وَ الۡبَحۡرِ الۡمَسۡجُوۡرِ ۙ﴿۶﴾

13
00:00:47,218 --> 00:00:49,779
এবং অগ্নি-প্রজ্বলিত সমুদ্রের–

14
00:00:49,779 --> 00:00:54,418
اِنَّ عَذَابَ رَبِّکَ لَوَاقِعٌ ۙ﴿۷﴾

15
00:00:54,418 --> 00:00:57,618
নিশ্চয় তোমার প্রতিপালকের শাস্তি অবশ্যম্ভাবী;

16
00:00:57,618 --> 00:01:01,571
مَّا لَہٗ مِنۡ دَافِعٍ ۙ﴿۸﴾

17
00:01:01,571 --> 00:01:03,985
সেটা কেউ দূরীভূত করতে পারবে না।

18
00:01:03,985 --> 00:01:09,721
یَّوۡمَ تَمُوۡرُ السَّمَآءُ مَوۡرًا ۙ﴿۹﴾

19
00:01:09,721 --> 00:01:13,161
যে দিন আসমান আন্দোলিত হবার মতো আন্দোলিত হবে;

20
00:01:13,161 --> 00:01:16,921
وَّ تَسِیۡرُ الۡجِبَالُ سَیۡرًا ﴿ؕ۱۰﴾

21
00:01:16,921 --> 00:01:20,041
এবং পর্বতমালা চলার মতো চলতে থাকবে;

22
00:01:20,041 --> 00:01:27,273
فَوَیۡلٌ یَّوۡمَئِذٍ لِّلۡمُکَذِّبِیۡنَ ﴿ۙ۱۱﴾

23
00:01:27,273 --> 00:01:30,641
সুতরাং সে দিন দুর্ভোগ অস্বীকারকারীদের জন্য–

24
00:01:30,641 --> 00:01:37,969
الَّذِیۡنَ ہُمۡ فِیۡ خَوۡضٍ یَّلۡعَبُوۡنَ ﴿ۘ۱۲﴾

25
00:01:37,969 --> 00:01:41,174
যারা অসার কার্যকলাপের মধ্যে খেলা করছে।

26
00:01:41,174 --> 00:01:48,187
یَوۡمَ یُدَعُّوۡنَ اِلٰی نَارِ جَہَنَّمَ دَعًّا ﴿ؕ۱۳﴾

27
00:01:48,187 --> 00:01:52,587
যে দিন তাদেরকে জাহান্নামের দিকে সজোরে ধাক্কা দিতে দিতে নিয়ে যাওয়া হবে–

28
00:01:52,587 --> 00:02:02,647
ہٰذِہِ النَّارُ الَّتِیۡ کُنۡتُمۡ بِہَا تُکَذِّبُوۡنَ ﴿۱۴﴾

29
00:02:02,647 --> 00:02:06,167
‘এটা হচ্ছে ঐ আগুন, যাকে তোমরা অস্বীকার করতে।’

30
00:02:06,167 --> 00:02:15,815
اَفَسِحۡرٌ ہٰذَاۤ اَمۡ اَنۡتُمۡ لَا تُبۡصِرُوۡنَ ﴿ۚ۱۵﴾

31
00:02:15,815 --> 00:02:19,100
তবে কি এটা যাদু? না তোমরা দেখতে পাচ্ছো না!

32
00:02:19,100 --> 00:02:38,259
اِصۡلَوۡہَا فَاصۡبِرُوۡۤا اَوۡ لَا تَصۡبِرُوۡا ۚ سَوَآءٌ عَلَیۡکُمۡ ؕ اِنَّمَا تُجۡزَوۡنَ مَا کُنۡتُمۡ تَعۡمَلُوۡنَ ﴿۱۶﴾

33
00:02:38,259 --> 00:02:49,139
তাতে প্রবেশ করো এবং এখন চাই ধৈর্য ধরো, কিংবা না-ই ধরো– উভয়টাই তোমাদের জন্য সমান। তোমাদের জন্য সেটারই বিনিময়, যা তোমরা করছিলে।

34
00:02:49,139 --> 00:02:59,158
اِنَّ الۡمُتَّقِیۡنَ فِیۡ جَنّٰتٍ وَّ نَعِیۡمٍ ﴿ۙ۱۷﴾

35
00:02:59,158 --> 00:03:03,173
নিশ্চয় খোদাভীরুগণ বাগানসমূহে এবং শান্তিতে রয়েছে।

36
00:03:03,173 --> 00:03:16,128
فٰکِہِیۡنَ بِمَاۤ اٰتٰہُمۡ رَبُّہُمۡ ۚ وَ وَقٰہُمۡ رَبُّہُمۡ عَذَابَ الۡجَحِیۡمِ ﴿۱۸﴾

37
00:03:16,128 --> 00:03:24,288
আপন প্রতিপালকের প্রদত্ত নি’মাতের উপর আনন্দিত; এবং তাদেরকে তাদের প্রতিপালক আগুনের শাস্তি থেকে রক্ষা করেছেন।

38
00:03:24,288 --> 00:03:35,308
کُلُوۡا وَ اشۡرَبُوۡا ہَنِیۡٓـًٔۢا بِمَا کُنۡتُمۡ تَعۡمَلُوۡنَ ﴿ۙ۱۹﴾

39
00:03:35,308 --> 00:03:41,154
আহার করো ও পান করো তৃপ্তি সহকারে– পুরস্কারস্বরূপ আপন কর্মসমূহের;

40
00:03:41,154 --> 00:03:53,355
مُتَّکِئِیۡنَ عَلٰی سُرُرٍ مَّصۡفُوۡفَۃٍ ۚ وَ زَوَّجۡنٰہُمۡ بِحُوۡرٍ عِیۡنٍ ﴿۲۰﴾

41
00:03:53,355 --> 00:04:02,635
তারা আসনসমূহে হেলান দিয়ে বসবে, যেগুলো সারিবদ্ধভাবে সজ্জিত; এবং আমি তাদের বিবাহ দেবো বড় বড় চোখসম্পন্না হুরদের সাথে।

42
00:04:02,635 --> 00:04:31,335
وَ الَّذِیۡنَ اٰمَنُوۡا وَ اتَّبَعَتۡہُمۡ ذُرِّیَّتُہُمۡ بِاِیۡمَانٍ اَلۡحَقۡنَا بِہِمۡ ذُرِّیَّتَہُمۡ وَ مَاۤ اَلَتۡنٰہُمۡ مِّنۡ عَمَلِہِمۡ مِّنۡ شَیۡءٍ ؕ کُلُّ امۡرِیًٴۢ بِمَا کَسَبَ رَہِیۡنٌ ﴿۲۱﴾

43
00:04:31,335 --> 00:04:47,523
এবং যারা ঈমান এনেছে আর তাদের সন্তানগণ ঈমান সহকারে তাদের অনুসরণ করেছে, আমি তাদের সন্তানদেরকে তাদের সাথে মিলন ঘটাবো এবং তাদের কর্মের মধ্যে তাদেরকে কিছুই কম দেবো না। প্রত্যেক মানুষ আপন কৃতকর্মের মধ্যে আবদ্ধ থাকবে।

44
00:04:47,523 --> 00:04:58,923
وَ اَمۡدَدۡنٰہُمۡ بِفَاکِہَۃٍ وَّ لَحۡمٍ مِّمَّا یَشۡتَہُوۡنَ ﴿۲۲﴾

45
00:04:58,923 --> 00:05:04,923
এবং আমি তাদের সাহায্য করবো ফলমূল ও মাংস দ্বারা, যা তারা আকাঙ্ক্ষা করবে।

46
00:05:04,923 --> 00:05:14,964
یَتَنَازَعُوۡنَ فِیۡہَا کَاۡسًا لَّا لَغۡوٌ فِیۡہَا وَ لَا تَاۡثِیۡمٌ ﴿۲۳﴾

47
00:05:14,964 --> 00:05:22,004
একে অপরের নিকট থেকে নেবে ঐ পানপাত্র, যার মধ্যে না থাকবে অনর্থক কথাবার্তা, না পাপ।

48
00:05:22,004 --> 00:05:33,372
وَ یَطُوۡفُ عَلَیۡہِمۡ غِلۡمَانٌ لَّہُمۡ کَاَنَّہُمۡ لُؤۡلُؤٌ مَّکۡنُوۡنٌ ﴿۲۴﴾

49
00:05:33,372 --> 00:05:40,904
এবং তাদের সেবক বালকগণ তাদের চতুর্দিকে ঘুরবে, যেন তারা মুক্তা, গোপনে সংরক্ষণ করা হয়েছে।

50
00:05:40,904 --> 00:05:50,977
وَ اَقۡبَلَ بَعۡضُہُمۡ عَلٰی بَعۡضٍ یَّتَسَآءَلُوۡنَ ﴿۲۵﴾

51
00:05:50,977 --> 00:05:56,104
এবং তাদের মধ্যে একে অপরের দিকে মুখ করেছে জিজ্ঞাসাকারী অবস্থায়।

52
00:05:56,104 --> 00:06:07,983
قَالُوۡۤا اِنَّا کُنَّا قَبۡلُ فِیۡۤ اَہۡلِنَا مُشۡفِقِیۡنَ ﴿۲۶﴾

53
00:06:07,983 --> 00:06:13,271
তারা বললো, ‘নিশ্চয় আমরা ইতোপূর্বে আমাদের গৃহগুলোর মধ্যে ভীত অবস্থায় ছিলাম।

54
00:06:13,271 --> 00:06:23,152
فَمَنَّ اللّٰہُ عَلَیۡنَا وَ وَقٰىنَا عَذَابَ السَّمُوۡمِ ﴿۲۷﴾

55
00:06:23,152 --> 00:06:29,472
অতঃপর আল্লাহ্ আমাদের উপর অনুগ্রহ করেছেন এবং আমাদেরকে ‘লূ’-এর শাস্তি থেকে রক্ষা করেছেন।

56
00:06:29,472 --> 00:06:44,053
اِنَّا کُنَّا مِنۡ قَبۡلُ نَدۡعُوۡہُ ؕ اِنَّہٗ ہُوَ الۡبَرُّ الرَّحِیۡمُ ﴿۲۸﴾

57
00:06:44,053 --> 00:06:51,013
নিশ্চয় আমরা আমাদের প্রথম জীবনে তাঁরই ইবাদত করেছিলাম। নিশ্চয় তিনিই অনুগ্রহশীল, দয়ালু।’

58
00:06:51,013 --> 00:07:03,817
فَذَکِّرۡ فَمَاۤ اَنۡتَ بِنِعۡمَتِ رَبِّکَ بِکَاہِنٍ وَّ لَا مَجۡنُوۡنٍ ﴿ؕ۲۹﴾

59
00:07:03,817 --> 00:07:11,913
অতঃপর হে মাহবূব! আপনি উপদেশ দিন যে, ‘আপনি আপন প্রতিপালকের অনুগ্রহে না ‘জ্যোতিষী’ হন, না ‘উন্মাদ’।

60
00:07:11,913 --> 00:07:20,925
اَمۡ یَقُوۡلُوۡنَ شَاعِرٌ نَّتَرَبَّصُ بِہٖ رَیۡبَ الۡمَنُوۡنِ ﴿۳۰﴾

61
00:07:20,925 --> 00:07:26,446
অথবা তারা কি বলে, ‘তিনি কবি, আমরা তাঁর উপর কালের বিপর্যয়ের অপেক্ষা করছি?’

62
00:07:26,446 --> 00:07:36,445
قُلۡ تَرَبَّصُوۡا فَاِنِّیۡ مَعَکُمۡ مِّنَ الۡمُتَرَبِّصِیۡنَ ﴿ؕ۳۱﴾

63
00:07:36,445 --> 00:07:40,613
আপনি বলুন, ‘অপেক্ষা করতে থাকো। আমিও তোমাদের অপেক্ষায় আছি।’

64
00:07:40,613 --> 00:07:52,373
اَمۡ تَاۡمُرُہُمۡ اَحۡلَامُہُمۡ بِہٰذَاۤ اَمۡ ہُمۡ قَوۡمٌ طَاغُوۡنَ ﴿ۚ۳۲﴾

65
00:07:52,373 --> 00:07:56,779
তাদের বিবেক-বুদ্ধি কি তাদেরকে এ নির্দেশ দিচ্ছে, না তারা অবাধ্য লোক?

66
00:07:56,779 --> 00:08:04,358
اَمۡ یَقُوۡلُوۡنَ تَقَوَّلَہٗ ۚ بَلۡ لَّا یُؤۡمِنُوۡنَ ﴿ۚ۳۳﴾

67
00:08:04,358 --> 00:08:10,046
অথবা তারা কি বলে, ‘তিনি এ ক্বোরআন রচনা করে নিয়েছেন?’ বরং তারা ঈমান রাখে না।

68
00:08:10,046 --> 00:08:20,936
فَلۡیَاۡتُوۡا بِحَدِیۡثٍ مِّثۡلِہٖۤ اِنۡ کَانُوۡا صٰدِقِیۡنَ ﴿ؕ۳۴﴾

69
00:08:20,936 --> 00:08:25,816
সুতরাং তারা যেন এমন একটা বাণী নিয়ে আসে, যদি তারা সত্যবাদী হয়!

70
00:08:25,816 --> 00:08:33,586
اَمۡ خُلِقُوۡا مِنۡ غَیۡرِ شَیۡءٍ اَمۡ ہُمُ الۡخٰلِقُوۡنَ ﴿ؕ۳۵﴾

71
00:08:33,586 --> 00:08:37,116
তারা কি কোন মূল থেকে সৃষ্ট নয়, না তারা স্রষ্টা?

72
00:08:37,116 --> 00:08:45,607
اَمۡ خَلَقُوا السَّمٰوٰتِ وَ الۡاَرۡضَ ۚ بَلۡ لَّا یُوۡقِنُوۡنَ ﴿ؕ۳۶﴾

73
00:08:45,607 --> 00:08:51,127
না কি আসমান ও যমীনকে তারাই সৃষ্টি করেছে? বরং তাদের নিশ্চিত বিশ্বাস নেই।

74
00:08:51,127 --> 00:09:02,102
اَمۡ عِنۡدَہُمۡ خَزَآئِنُ رَبِّکَ اَمۡ ہُمُ الۡمُصَۜیۡطِرُوۡنَ ﴿ؕ۳۷﴾

75
00:09:02,102 --> 00:09:06,594
আপনার প্রতিপালকের ভাণ্ডার কি তাদের নিকট রয়েছে, না তারা নিয়ন্তা?

76
00:09:06,594 --> 00:09:21,836
اَمۡ لَہُمۡ سُلَّمٌ یَّسۡتَمِعُوۡنَ فِیۡہِ ۚ فَلۡیَاۡتِ مُسۡتَمِعُہُمۡ بِسُلۡطٰنٍ مُّبِیۡنٍ ﴿ؕ۳۸﴾

77
00:09:21,836 --> 00:09:29,996
না কি তাদের নিকট কোন সিঁড়ি আছে, যাতে আরোহণ করে তারা শুনে নেয়? থাকলে তাদের শ্রবণকারী সুস্পষ্ট সনদ নিয়ে আসুক!

78
00:09:29,996 --> 00:09:36,194
اَمۡ لَہُ الۡبَنٰتُ وَ لَکُمُ الۡبَنُوۡنَ ﴿ؕ۳۹﴾

79
00:09:36,194 --> 00:09:39,796
তবে কি কন্যাগণ তাঁরই, আর পুত্রগণ তোমাদের?

80
00:09:39,796 --> 00:09:51,004
اَمۡ تَسۡـَٔلُہُمۡ اَجۡرًا فَہُمۡ مِّنۡ مَّغۡرَمٍ مُّثۡقَلُوۡنَ ﴿ؕ۴۰﴾

81
00:09:51,004 --> 00:09:57,496
তবে কি আপনি তাদের নিকট থেকে কোন পারিশ্রমিক চাচ্ছেন? ফলে তারা করের বোঝায় চাপা পড়ে আছে!

82
00:09:57,496 --> 00:10:05,159
اَمۡ عِنۡدَہُمُ الۡغَیۡبُ فَہُمۡ یَکۡتُبُوۡنَ ﴿ؕ۴۱﴾

83
00:10:05,159 --> 00:10:09,799
নাকি তাদের নিকট অদৃশ্য জ্ঞান আছে, যা দ্বারা তারা বিধি লিপিবদ্ধ করে?

84
00:10:09,799 --> 00:10:19,691
اَمۡ یُرِیۡدُوۡنَ کَیۡدًا ؕ فَالَّذِیۡنَ کَفَرُوۡا ہُمُ الۡمَکِیۡدُوۡنَ ﴿ؕ۴۲﴾

85
00:10:19,691 --> 00:10:26,411
অথবা তারা কি কোন চক্রান্তের ইচ্ছা করছে? অতঃপর কাফিরদেরই উপর চক্রান্ত আপতিত হওয়া সমীচীন।

86
00:10:26,411 --> 00:10:39,920
اَمۡ لَہُمۡ اِلٰہٌ غَیۡرُ اللّٰہِ ؕ سُبۡحٰنَ اللّٰہِ عَمَّا یُشۡرِکُوۡنَ ﴿۴۳﴾

87
00:10:39,920 --> 00:10:45,444
নাকি আল্লাহ্ ব্যতীত তাদের অন্য কোন খোদা আছে? আল্লাহ্‌রই পবিত্রতা তাদের শির্ক থেকে।

88
00:10:45,444 --> 00:11:00,202
وَ اِنۡ یَّرَوۡا کِسۡفًا مِّنَ السَّمَآءِ سَاقِطًا یَّقُوۡلُوۡا سَحَابٌ مَّرۡکُوۡمٌ ﴿۴۴﴾

89
00:11:00,202 --> 00:11:07,322
এবং যদি আসমান থেকে কোন টুকরা পতিত হতে দেখে তবে বলবে, ‘তা তো পুঞ্জিভূত মেঘখণ্ড!’

90
00:11:07,322 --> 00:11:16,535
فَذَرۡہُمۡ حَتّٰی یُلٰقُوۡا یَوۡمَہُمُ الَّذِیۡ فِیۡہِ یُصۡعَقُوۡنَ ﴿ۙ۴۵﴾

91
00:11:16,535 --> 00:11:23,822
সুতরাং আপনি তাদেরকে ছেড়ে দিন যে পর্যন্ত না তারা তাদের ঐ দিনের সাক্ষাত পায়, যেদিন তারা বেহুঁশ হয়ে পড়বে।

92
00:11:23,822 --> 00:11:34,714
یَوۡمَ لَا یُغۡنِیۡ عَنۡہُمۡ کَیۡدُہُمۡ شَیۡئًا وَّ لَا ہُمۡ یُنۡصَرُوۡنَ ﴿ؕ۴۶﴾

93
00:11:34,714 --> 00:11:39,289
যেদিন তাদের চক্রান্ত কোন কাজে আসবে না, না তাদের সাহায্য করা হবে।

94
00:11:39,289 --> 00:11:53,916
وَ اِنَّ لِلَّذِیۡنَ ظَلَمُوۡا عَذَابًا دُوۡنَ ذٰلِکَ وَ لٰکِنَّ اَکۡثَرَہُمۡ لَا یَعۡلَمُوۡنَ ﴿۴۷﴾

95
00:11:53,916 --> 00:12:00,489
এবং নিশ্চয় যালিমদের জন্য এর পূর্বে একটা শাস্তি আছে, কিন্তু তাদের মধ্যে অধিকাংশের নিকট খবর নেই।

96
00:12:00,489 --> 00:12:14,422
وَ اصۡبِرۡ لِحُکۡمِ رَبِّکَ فَاِنَّکَ بِاَعۡیُنِنَا وَ سَبِّحۡ بِحَمۡدِ رَبِّکَ حِیۡنَ تَقُوۡمُ ﴿ۙ۴۸﴾

97
00:12:14,422 --> 00:12:29,883
এবং হে মাহবূব! আপনি আপন প্রতিপালকের আদেশের উপর স্থির থাকুন। কারণ, নিশ্চয় আপনি আমার রক্ষণাবেক্ষণে রয়েছেন। এবং আপন প্রতিপালকের প্রশংসাকারী হয়ে তাঁর পবিত্রতা ঘোষণা করুন! যখন আপনি দণ্ডায়মান হোন।

98
00:12:29,883 --> 00:12:40,087
وَ مِنَ الَّیۡلِ فَسَبِّحۡہُ وَ اِدۡبَارَ النُّجُوۡمِ ﴿۴۹﴾

99
00:12:40,087 --> 00:12:46,416
এবং রাতের কিছু অংশে তাঁর পবিত্রতা ঘোষণা করুন এবং তারকাগুলোর পৃষ্ঠ প্রদর্শনের সময়।

